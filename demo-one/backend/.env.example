# PostgreSQL connection for Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/demo_one

PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=https://fashion-fit-ruddy.vercel.app

# JWT (optional — used by auth routes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# EFT Bank Details (placeholders — replace with real values)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT=
BANK_BRANCH=

# Email (placeholders — replace with real provider credentials)
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Courier Guy API (placeholder — not integrated yet)
COURIER_API_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=
