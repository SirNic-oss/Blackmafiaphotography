# Database
DATABASE_URL=postgresql://user:password@localhost:5432/demo_one

# Server
PORT=5000

# Public URL of this backend (used for uploaded file URLs)
# Local:
PUBLIC_API_URL=http://localhost:5000

# Production:
# PUBLIC_API_URL=https://blackmafiaphotography.onrender.com

# Allowed browser origins (comma-separated, no trailing slashes)
# Local:
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Production:
# FRONTEND_URL=https://blackmafiaphotography-17yndgh8x-sir-nic.vercel.app
# ADMIN_URL=https://blackmafiaphotography-lbm5g.vercel.app

# Optional extra origins (comma-separated)
# ALLOWED_ORIGINS=https://blackmafiaphotography-17yndgh8x-sir-nic.vercel.app,https://blackmafiaphotography-lbm5g.vercel.app

# Auth
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# Business timezone offset (hours from UTC)
BUSINESS_UTC_OFFSET_HOURS=2
