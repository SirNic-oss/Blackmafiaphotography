generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  password      String
  firstName     String?
  lastName      String?
  role          UserRole    @default(USER)
  createdAt     DateTime    @default(now())

  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  cart          Cart[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  category      String
  description   String
  price         Float

  images        String[]
  colors        String[]
  sizes         String[]

  stock         Int

  createdAt     DateTime    @default(now())

  reviews       Review[]
  wishlist      Wishlist[]
  cart          Cart[]
}

model Category {
  id            String      @id @default(cuid())
  name          String      @unique
}

model Review {
  id            String      @id @default(cuid())

  rating        Int
  comment       String

  userId        String
  productId     String

  user          User        @relation(fields:[userId], references:[id])
  product       Product     @relation(fields:[productId], references:[id])
}

model Wishlist {
  id            String      @id @default(cuid())

  userId        String
  productId     String

  user          User        @relation(fields:[userId], references:[id])
  product       Product     @relation(fields:[productId], references:[id])
}

model Cart {
  id            String      @id @default(cuid())

  quantity      Int

  userId        String
  productId     String

  user          User        @relation(fields:[userId], references:[id])
  product       Product     @relation(fields:[productId], references:[id])
}

model Order {
  id            String      @id @default(cuid())

  total         Float

  status        OrderStatus @default(PENDING)

  createdAt     DateTime    @default(now())

  userId        String

  user          User        @relation(fields:[userId], references:[id])

  payments      Payment[]
}

model Payment {
  id            String      @id @default(cuid())

  amount        Float
  provider      String

  createdAt     DateTime    @default(now())

  orderId       String

  order         Order       @relation(fields:[orderId], references:[id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

model PhotographyService {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String
  durationMinutes Int
  price           Float?
  active          Boolean   @default(true)
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  serviceId       String
  startAt         DateTime
  endAt           DateTime
  timezone        String        @default("Africa/Johannesburg")
  message         String?
  adminNotes      String?
  status          BookingStatus @default(PENDING)
  serviceName     String
  durationMinutes Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer           @relation(fields: [customerId], references: [id])
  service         PhotographyService @relation(fields: [serviceId], references: [id])
  slots           BookingSlot[]

  @@index([startAt, endAt])
  @@index([status, startAt])
}

model BookingSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime @unique
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt, endAt])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  category     String
  imageUrl     String
  altText      String?
  description  String?
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
}

model Testimonial {
  id           String   @id @default(cuid())
  clientName   String
  quote        String
  rating       Int      @default(5)
  category     String?
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, displayOrder])
}

model SiteSetting {
  id          String   @id @default(cuid())
  businessName String  @default("Lumen Studio")
  email       String?
  phone       String?
  location    String?
  instagram   String?
  facebook    String?
  pinterest   String?
  about       String?
  updatedAt   DateTime @updatedAt
}
